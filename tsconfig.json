{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "rootDir": ".",
    "outDir": "./dist/cjs",
    "declaration": true,
    "declarationDir": "./dist/types",
    "types": ["node", "jest"],
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true,
    "strictPropertyInitialization": false,
    "resolveJsonModule": true,
    "inlineSourceMap": true,
    "inlineSources": true
  },
  "include": ["bin", "lib", "context"],
  "exclude": [
    "node_modules",
    "cdk.out",
    "dist",
    "**/*.test.ts",
    "bin/origin-swap"
  ]
}
