{
  "name": "shibboleth-sp-at-edge",
  "version": "1.0.0",
  "description": "Builds a cloudfront-based authentication proxy for shibboleth clients",
  "scripts": {
    "cleanup": "tsx bin/LambdaVersionCleanup.ts",
    "clearcache": "sh bin/clear-cache.sh",
    "create-secret": "node --env-file=.env --import tsx -e \"require('./lib/secrets/SecretsManager.ts').createOrUpdateSecrets()\"",
    "share-secret": "node --env-file=.env --import tsx -e \"require('./lib/secrets/SecretsManager.ts').attachSecretPolicyForAccount(process.argv[1], process.argv[2])\"",
    "share-secret2": "node --env-file=.env --import tsx -e \"require('./lib/secrets/SecretsManager.ts').attachSecretPolicyForAccount(process.argv[1], process.argv[2])\"",
    "test": "jest --silent",
    "cdk": "cdk",
    "deploy": "cdk deploy --all --no-rollback --require-approval never",
    "redeploy": "cdk destroy --all -f && npm run deploy --all",
    "get-stack-name": "node --import tsx -e \"require('./lib/Util.ts').echoStackName()\"",
    "synth": "npm run get-stack-name | xargs cdk synth 2>&1 | tee cdk.out/synth.output.yaml",
    "build": "node bin/build/build.js",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "pack": "npm pack --pack-destination ."
  },
  "main": "./dist/cjs/bin/build/index.js",
  "types": "./dist/types/bin/build/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/bin/build/index.d.ts",
      "default": "./dist/cjs/bin/build/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "build/"
  ],
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.540.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.577.0",
    "@aws-sdk/client-lambda": "^3.462.0",
    "@aws-sdk/client-route-53": "^3.964.0",
    "@aws-sdk/client-secrets-manager": "^3.577.0",
    "@aws-sdk/client-ssm": "^3.972.0",
    "@aws-sdk/client-sts": "^3.964.0",
    "aws-cdk-lib": "^2.223.0",
    "constructs": "^10.0.0",
    "shibboleth-sp": "https://simple-npm-package-bucket.s3.us-east-1.amazonaws.com/shibboleth-sp/shibboleth-sp-1.1.0.tgz"
  },
  "devDependencies": {
    "@aws-sdk/client-acm": "^3.985.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.962.0",
    "@aws-sdk/client-iam": "^3.962.0",
    "@types/jest": "^29.5.12",
    "@types/node": "20.6.3",
    "aws-cdk": "^2.1031.2",
    "aws-sdk-client-mock": "^3.1.0",
    "aws-sdk-client-mock-jest": "^3.1.0",
    "esbuild": "^0.25.11",
    "jest": "^29.7.0",
    "jszip": "^3.10.1",
    "ts-jest": "^29.4.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "js-yaml": "^3.14.2"
  }
}
